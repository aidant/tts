{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "erasableSyntaxOnly": true,
    "lib": ["ES2021"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "lib",
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2021",
    "verbatimModuleSyntax": true
  }
}
